# --- Database ---
# Postgres connection string. Locally, the bundled docker-compose.yml
# matches this URL — run `docker compose up -d` and you're good.
# Production: point at Neon / Supabase / Railway / your provider.
DATABASE_URL="postgresql://toast:toast@localhost:5432/toast?schema=public"

# --- App ---
# Public URL where the app is reachable. Used in magic-link emails and
# inquiry notifications. No trailing slash. REQUIRED in production —
# the server logs an error if missing.
APP_URL="http://localhost:3000"

# --- Email (optional in dev, required in prod) ---
# Resend API key. Without it, magic links and inquiry notifications
# print to the server console instead of being emailed.
# RESEND_API_KEY="re_xxxxxxxx"

# Default From address. Must use a verified Resend domain in production
# (the server throws if unset when NODE_ENV=production). The sandbox
# address `onboarding@resend.dev` only delivers to the Resend account
# owner's inbox — fine for one-off dev tests, useless past that.
# RESEND_FROM="Clinkdeck <hello@clinkdeck.com>"

# Optional: route every inquiry email to this address regardless of
# the creator's real email. Useful for QA / staging.
# DEMO_TO_OVERRIDE="you@example.com"

# --- Google Ads conversions (optional) ---
# After you create conversion actions in Google Ads → Tools → Conversions,
# paste the full "Send To" value below (looks like AW-18156684082/AbCd1xYz).
# Each fires once per user, client-side, when the user lands on the destination
# page with the appropriate query flag (?signup=1 / ?published=1).
# Without these, only the base pageview tag fires — no conversions recorded.
# Note: NEXT_PUBLIC_* vars are inlined at build time, so changing them in
# Vercel requires a redeploy to take effect.
# NEXT_PUBLIC_GOOGLE_ADS_SIGNUP_LABEL="AW-18156684082/your_signup_label"
# NEXT_PUBLIC_GOOGLE_ADS_PUBLISH_LABEL="AW-18156684082/your_publish_label"

# --- Stripe (required for featured-listing checkout) ---
# Secret key from https://dashboard.stripe.com/apikeys (use sk_test_* in dev).
# STRIPE_SECRET_KEY="sk_test_xxxxxxxx"

# Webhook signing secret. In dev, run `stripe listen --forward-to
# localhost:3000/api/stripe/webhook` and paste the whsec_ it prints.
# STRIPE_WEBHOOK_SECRET="whsec_xxxxxxxx"
